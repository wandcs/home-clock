# No CMake cache variable: every reconfigure reads the current explicit selection.
set(clock_alarm_audio_tools "${CMAKE_CURRENT_LIST_DIR}")
function(clock_add_alarm_reference target python)
    set(audio_root "${clock_alarm_audio_tools}/../..")
    set(audio_script "${clock_alarm_audio_tools}/prepare-private.py")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${audio_script}")
    if("$ENV{HOME_CLOCK_ALARM_AUDIO_WAV}" STREQUAL "")
        target_sources(${target} PRIVATE "${audio_root}/firmware/features/alarm-audio/alarm_reference.c")
        message(STATUS "Alarm audio: original public synthesis")
    else()
        set(audio_output "${CMAKE_CURRENT_BINARY_DIR}/private-alarm/reference.c")
        execute_process(COMMAND "${python}" "${audio_script}" --output "${audio_output}"
            RESULT_VARIABLE audio_result OUTPUT_QUIET ERROR_QUIET)
        if(NOT audio_result EQUAL 0)
            message(FATAL_ERROR "Explicit private alarm audio is missing or invalid; mono 22050Hz PCM16 WAV required")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "$ENV{HOME_CLOCK_ALARM_AUDIO_WAV}")
        target_sources(${target} PRIVATE "${audio_output}")
        message(STATUS "Alarm audio: explicit private build input (do not publish firmware)")
    endif()
endfunction()
