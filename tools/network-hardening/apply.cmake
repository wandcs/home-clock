# Patch only reviewed compilation inputs in this build directory.
# Shared ESP-IDF and managed-component files remain unchanged.
include_guard(GLOBAL)
idf_build_get_property(clock_network_python PYTHON)
get_filename_component(clock_network_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)

function(clock_network_patch_source component source_name patch_directory)
    if(TARGET "${component}")
        set(component_library "${component}")
    else()
        idf_component_get_property(component_library "${component}" COMPONENT_LIB)
    endif()
    get_target_property(component_directory "${component_library}" SOURCE_DIR)
    get_target_property(component_sources "${component_library}" SOURCES)
    set(patched_sources "")
    set(matches 0)
    foreach(source IN LISTS component_sources)
        get_filename_component(source_leaf "${source}" NAME)
        if(source_leaf STREQUAL source_name)
            math(EXPR matches "${matches} + 1")
        endif()
    endforeach()
    if(NOT matches EQUAL 1)
        message(FATAL_ERROR "Expected exactly one reviewed ${source_name} source in ${component}; found ${matches}")
    endif()
    foreach(source IN LISTS component_sources)
        get_filename_component(source_leaf "${source}" NAME)
        if(source_leaf STREQUAL source_name)
            get_filename_component(original "${source}" ABSOLUTE BASE_DIR "${component_directory}")
            set(generator "${clock_network_root}/tools/network-hardening/${patch_directory}/prepare.py")
            set(output "${CMAKE_BINARY_DIR}/clock-network-fixes/${patch_directory}/${source_name}")
            execute_process(COMMAND "${clock_network_python}" "${generator}"
                --source "${original}" --output "${output}"
                RESULT_VARIABLE result OUTPUT_VARIABLE binding ERROR_VARIABLE failure)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "Reviewed ${component} network patch failed: ${failure}")
            endif()
            message(STATUS "Home Clock ${component} patch: ${binding}")
            list(APPEND patched_sources "${output}")
            # Preserve quote-includes relative to the original source directory.
            get_filename_component(original_directory "${original}" DIRECTORY)
            target_include_directories("${component_library}" PRIVATE "${original_directory}")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${generator}")
            if(patch_directory STREQUAL "sdio")
                set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
                    "${clock_network_root}/tools/network-hardening/sdio/streaming-rx.inc")
            endif()
        else()
            list(APPEND patched_sources "${source}")
        endif()
    endforeach()
    set_property(TARGET "${component_library}" PROPERTY SOURCES "${patched_sources}")
endfunction()

clock_network_patch_source("esp-tls" "esp_tls.c" "tls")
clock_network_patch_source("eh_host_mcu_transport" "eh_host_bus_sdio.c" "sdio")
